# Copy to .env to override the defaults used by docker-compose.yml.

# Postgres (one server; databases orders_db, inventory_db, payment_db)
POSTGRES_USER=shopflow
POSTGRES_PASSWORD=shopflow
# 5433 so it does not clash with a Postgres installed on the host.
POSTGRES_PORT=5433

# Kafka listener for apps running on the host: localhost:${KAFKA_PORT}
KAFKA_PORT=9092

# AKHQ web UI: http://localhost:${AKHQ_PORT}
AKHQ_PORT=8080
