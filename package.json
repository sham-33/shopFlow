{
  "name": "shopflow",
  "version": "0.0.1",
  "description": "Event-driven e-commerce backend: Order, Inventory and Payment services talking over Kafka",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "nest build --all",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.spec.json",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:cov": "vitest run --project unit --coverage",
    "test:int": "vitest run --project integration",
    "typeorm": "tsx --tsconfig tsconfig.spec.json node_modules/typeorm/cli.js",
    "migration:generate:inventory": "npm run typeorm -- migration:generate -d apps/inventory-service/src/config/data-source.ts",
    "migration:run:inventory": "npm run typeorm -- migration:run -d apps/inventory-service/src/config/data-source.ts",
    "migration:revert:inventory": "npm run typeorm -- migration:revert -d apps/inventory-service/src/config/data-source.ts",
    "migration:generate:order": "npm run typeorm -- migration:generate -d apps/order-service/src/config/data-source.ts",
    "migration:run:order": "npm run typeorm -- migration:run -d apps/order-service/src/config/data-source.ts",
    "migration:revert:order": "npm run typeorm -- migration:revert -d apps/order-service/src/config/data-source.ts",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,mts,cts,js,mjs,cjs}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": "prettier --write"
  },
  "dependencies": {
    "@nestjs/common": "^12.6.0",
    "@nestjs/core": "^12.6.0",
    "@nestjs/platform-express": "^12.6.0",
    "@nestjs/swagger": "^12.1.2",
    "@nestjs/terminus": "^12.2.0",
    "@nestjs/typeorm": "^12.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "nestjs-pino": "^5.3.2",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.15",
    "@nestjs/schematics": "^12.0.16",
    "@nestjs/testing": "^12.6.0",
    "@rspack/core": "^2.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "fork-ts-checker-webpack-plugin": "^9.2.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.10.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.2",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^4.1.12",
    "webpack-node-externals": "^3.0.0"
  }
}
